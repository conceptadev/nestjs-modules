{
  "roots": [
    "<rootDir>/packages/nestjs-core",
    "<rootDir>/packages/nestjs-repository",
    "<rootDir>/packages/nestjs-repository-typeorm",
    "<rootDir>/packages/nestjs-crud",
    "<rootDir>/packages/nestjs-cache",
    "<rootDir>/packages/nestjs-otp",
    "<rootDir>/packages/nestjs-role",
    "<rootDir>/packages/nestjs-password",
    "<rootDir>/packages/nestjs-user",
    "<rootDir>/packages/nestjs-invitation",
    "<rootDir>/packages/nestjs-federated",
    "<rootDir>/packages/nestjs-authentication",
    "<rootDir>/packages/nestjs-access-control"
  ],
  "moduleFileExtensions": ["js", "json", "ts"],
  "setupFilesAfterEnv": ["<rootDir>/jest.setup.js", "jest-extended/all"],
  "coverageThreshold": {
    "global": {
      "branches": 0,
      "functions": 0,
      "lines": 0,
      "statements": 0
    }
  },
  "testRegex": ".*\\.spec\\.ts$",
  "testPathIgnorePatterns": ["/node_modules/", "/dist/"],
  "transformIgnorePatterns": ["node_modules/(?!@nestjs/)"],
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "tsconfig": "tsconfig.jest.json" }],
    "node_modules/@nestjs/.+\\.(?:js|mjs|cjs)$": [
      "<rootDir>/scripts/jest-nestjs-transform.cjs"
    ]
  },
  "collectCoverageFrom": [
    "packages/nestjs-core/**/*.ts",
    "packages/nestjs-repository/**/*.ts",
    "packages/nestjs-repository-typeorm/**/*.ts",
    "packages/nestjs-crud/**/*.ts",
    "packages/nestjs-cache/**/*.ts",
    "packages/nestjs-otp/**/*.ts",
    "packages/nestjs-role/**/*.ts",
    "packages/nestjs-password/**/*.ts",
    "packages/nestjs-user/**/*.ts",
    "packages/nestjs-invitation/**/*.ts",
    "packages/nestjs-federated/**/*.ts",
    "packages/nestjs-authentication/**/*.ts",
    "packages/nestjs-access-control/**/*.ts",
    "!packages/**/*.d.ts",
    "!packages/**/*.interface.ts",
    "!packages/**/*.e2e-spec.ts",
    "!packages/**/*.factory.ts",
    "!packages/**/*.seeder.ts",
    "!packages/**/*.seeding.ts",
    "!packages/nestjs-samples/src/**/main.ts",
    "!**/node_modules/**",
    "!**/__mocks__/**",
    "!**/__stubs__/**",
    "!**/__fixtures__/**"
  ],
  "coverageDirectory": "coverage",
  "coverageReporters": [
    "text",
    "text-summary",
    "json",
    "json-summary",
    "lcovonly"
  ],
  "testEnvironment": "node",
  "resolver": "<rootDir>/scripts/jest-resolver.cjs"
}
