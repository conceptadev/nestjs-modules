{
  "name": "@concepta/nestjs-repository",
  "version": "8.0.0-alpha.7",
  "description": "Rockets NestJS Repository",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/!(*.spec|*.e2e-spec|*.fixture|*.mock).{js,d.ts}",
    "!dist/**/__tests__/**",
    "!dist/**/__fixtures__/**"
  ],
  "dependencies": {
    "@concepta/nestjs-core": "^8.0.0-alpha.7",
    "@nestjs/common": "12.0.0-alpha.5",
    "@nestjs/core": "12.0.0-alpha.5",
    "@tsyche/membrane": "^0.7.0"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.0-alpha.5",
    "vitest": "^4.1.9",
    "vitest-mock-extended": "^4.0.0"
  },
  "peerDependencies": {
    "class-transformer": "*",
    "class-validator": "*",
    "rxjs": "^7.8.1"
  }
}
