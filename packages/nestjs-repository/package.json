{
  "name": "@concepta/nestjs-repository",
  "version": "8.0.0-alpha.7",
  "description": "Rockets NestJS Repository",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/esm/testing.d.ts",
        "default": "./dist/esm/testing.js"
      },
      "require": {
        "types": "./dist/cjs/testing.d.ts",
        "default": "./dist/cjs/testing.js"
      }
    }
  },
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/cjs/**/!(*.spec|*.e2e-spec|*.fixture|*.mock).{js,d.ts}",
    "dist/esm/**/!(*.spec|*.e2e-spec|*.fixture|*.mock).{js,d.ts}",
    "dist/cjs/package.json",
    "dist/esm/package.json",
    "!dist/**/__tests__/**",
    "!dist/**/__fixtures__/**"
  ],
  "dependencies": {
    "@concepta/nestjs-core": "^8.0.0-alpha.7",
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@tsyche/membrane": "^0.7.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.9",
    "jest-mock-extended": "^4.0.0"
  },
  "peerDependencies": {
    "class-transformer": "*",
    "class-validator": "*",
    "rxjs": "^7.8.1"
  },
  "module": "./dist/esm/index.js"
}
