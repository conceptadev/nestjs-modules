{
  "name": "@concepta/nestjs-access-control",
  "version": "8.0.0-alpha.7",
  "description": "Rockets NestJS Access Control",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/cjs/**/!(*.spec|*.e2e-spec|*.fixture|*.mock).{js,d.ts}",
    "dist/esm/**/!(*.spec|*.e2e-spec|*.fixture|*.mock).{js,d.ts}",
    "dist/cjs/package.json",
    "dist/esm/package.json",
    "!dist/**/__tests__/**",
    "!dist/**/__fixtures__/**"
  ],
  "dependencies": {
    "@concepta/nestjs-core": "^8.0.0-alpha.7",
    "@nestjs/common": "12.0.0-alpha.5",
    "@nestjs/config": "12.0.0-next.0",
    "@nestjs/core": "12.0.0-alpha.5",
    "@nestjs/cqrs": "^11.0.0",
    "accesscontrol": "^2.2.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/swagger": "12.0.0-alpha.2",
    "@nestjs/testing": "12.0.0-alpha.5",
    "@types/supertest": "^6.0.3",
    "jest-mock-extended": "^4.0.0",
    "supertest": "^6.3.4"
  },
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  }
}
