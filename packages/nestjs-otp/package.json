{
  "name": "@concepta/nestjs-otp",
  "version": "8.0.0-alpha.7",
  "description": "Rockets NestJS OTP",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./optional/typeorm": {
      "import": {
        "types": "./dist/esm/optional-typeorm.d.ts",
        "default": "./dist/esm/optional-typeorm.js"
      },
      "require": {
        "types": "./dist/cjs/optional-typeorm.d.ts",
        "default": "./dist/cjs/optional-typeorm.js"
      }
    },
    "./optional/seeding": {
      "import": {
        "types": "./dist/esm/optional-seeding.d.ts",
        "default": "./dist/esm/optional-seeding.js"
      },
      "require": {
        "types": "./dist/cjs/optional-seeding.d.ts",
        "default": "./dist/cjs/optional-seeding.js"
      }
    }
  },
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/cjs/**/!(*.spec|*.e2e-spec|*.fixture|*.mock).{js,d.ts}",
    "dist/esm/**/!(*.spec|*.e2e-spec|*.fixture|*.mock).{js,d.ts}",
    "dist/cjs/package.json",
    "dist/esm/package.json",
    "!dist/**/__tests__/**",
    "!dist/**/__fixtures__/**"
  ],
  "dependencies": {
    "@concepta/nestjs-core": "^8.0.0-alpha.7",
    "@concepta/nestjs-repository": "8.0.0-alpha.7",
    "@nestjs/common": "12.0.0-alpha.5",
    "@nestjs/config": "12.0.0-next.0",
    "@nestjs/core": "12.0.0-alpha.5",
    "@nestjs/cqrs": "^11.0.0"
  },
  "devDependencies": {
    "@concepta/nestjs-repository-typeorm": "8.0.0-alpha.7",
    "@concepta/typeorm-seeding": "^4.0.0",
    "@faker-js/faker": "^8.4.1",
    "@nestjs/testing": "12.0.0-alpha.5",
    "@nestjs/typeorm": "^11.0.0",
    "jest-mock-extended": "^4.0.0"
  },
  "peerDependencies": {
    "@concepta/typeorm-seeding": "^4.0.0",
    "@faker-js/faker": "^8.4.1",
    "class-transformer": "*",
    "class-validator": "*",
    "rxjs": "^7.1.0",
    "typeorm": "^0.3.0"
  },
  "peerDependenciesMeta": {
    "@concepta/typeorm-seeding": {
      "optional": true
    },
    "@faker-js/faker": {
      "optional": true
    },
    "typeorm": {
      "optional": true
    }
  },
  "module": "./dist/esm/index.js"
}
