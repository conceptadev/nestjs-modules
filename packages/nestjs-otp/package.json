{
  "name": "@concepta/nestjs-otp",
  "version": "8.0.0-alpha.6",
  "description": "Rockets NestJS OTP",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./optional/typeorm": {
      "types": "./dist/optional-typeorm.d.ts",
      "default": "./dist/optional-typeorm.js"
    },
    "./optional/seeding": {
      "types": "./dist/optional-seeding.d.ts",
      "default": "./dist/optional-seeding.js"
    }
  },
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/!(*.spec|*.e2e-spec|*.fixture|*.mock).{js,d.ts}",
    "!dist/**/__tests__/**",
    "!dist/**/__fixtures__/**"
  ],
  "dependencies": {
    "@concepta/nestjs-repository": "8.0.0-alpha.6",
    "@concepta/rockets-app": "^0.0.1-alpha.0",
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/cqrs": "^11.0.0"
  },
  "devDependencies": {
    "@concepta/nestjs-repository-typeorm": "8.0.0-alpha.6",
    "@concepta/typeorm-seeding": "^4.0.0",
    "@faker-js/faker": "^8.4.1",
    "@nestjs/testing": "^11.1.9",
    "@nestjs/typeorm": "^11.0.0",
    "jest-mock-extended": "^4.0.0"
  },
  "peerDependencies": {
    "@concepta/typeorm-seeding": "^4.0.0",
    "@faker-js/faker": "^8.4.1",
    "class-transformer": "*",
    "class-validator": "*",
    "rxjs": "^7.1.0",
    "typeorm": "^0.3.0"
  },
  "peerDependenciesMeta": {
    "@concepta/typeorm-seeding": {
      "optional": true
    },
    "@faker-js/faker": {
      "optional": true
    },
    "typeorm": {
      "optional": true
    }
  }
}
