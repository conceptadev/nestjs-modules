{
  "name": "@concepta/nestjs-common",
  "version": "8.0.0-alpha.6",
  "description": "Rockets NestJS Common",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public"
  },
  "files": [
