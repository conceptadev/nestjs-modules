    "!dist/**/__tests__/**",
    "!dist/**/__fixtures__/**"
  ],
  "dependencies": {
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/swagger": "^11.2.2",
    "ms": "^2.1.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.9",
    "@types/supertest": "^6.0.3",
    "supertest": "^6.3.4"
  },
  "peerDependencies": {
    "class-transformer": "*",
    "class-validator": "*",
    "rxjs": "^7.0.0"
  }
