{
  "name": "@concepta/nestjs-core",
  "version": "8.0.0-alpha.7",
  "description": "Rockets App - Core framework module for Rockets applications",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./aggregate": {
      "import": {
        "types": "./dist/esm/index-aggregate.d.ts",
        "default": "./dist/esm/index-aggregate.js"
      },
      "require": {
        "types": "./dist/cjs/index-aggregate.d.ts",
        "default": "./dist/cjs/index-aggregate.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/esm/testing.d.ts",
        "default": "./dist/esm/testing.js"
      },
      "require": {
        "types": "./dist/cjs/testing.d.ts",
        "default": "./dist/cjs/testing.js"
      }
    }
  },
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/cjs/**/!(*.spec|*.e2e-spec|*.fixture|*.mock).{js,d.ts}",
    "dist/esm/**/!(*.spec|*.e2e-spec|*.fixture|*.mock).{js,d.ts}",
    "dist/cjs/package.json",
    "dist/esm/package.json",
    "!dist/**/__tests__/**",
    "!dist/**/__fixtures__/**"
  ],
  "dependencies": {
    "@nestjs/common": "12.0.0-alpha.5",
    "@nestjs/core": "12.0.0-alpha.5",
    "@nestjs/swagger": "12.0.0-alpha.2",
    "ms": "^2.1.3",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/testing": "12.0.0-alpha.5",
    "@types/supertest": "^6.0.3",
    "supertest": "^6.3.4",
    "vitest-mock-extended": "^4.0.0"
  },
  "peerDependencies": {
    "@nestjs/cqrs": "^11.0.0",
    "class-transformer": "*",
    "class-validator": "*",
    "rxjs": "^7.8.1"
  },
  "peerDependenciesMeta": {
    "@nestjs/cqrs": {
      "optional": true
    }
  },
  "module": "./dist/esm/index.js"
}
