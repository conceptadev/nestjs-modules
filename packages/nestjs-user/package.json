{
  "name": "@concepta/nestjs-user",
  "version": "8.0.0-alpha.9",
  "description": "Rockets NestJS User",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./optional/crud": {
      "types": "./dist/optional-crud.d.ts",
      "default": "./dist/optional-crud.js"
    },
    "./optional/seeding": {
      "types": "./dist/optional-seeding.d.ts",
      "default": "./dist/optional-seeding.js"
    },
    "./optional/typeorm": {
      "types": "./dist/optional-typeorm.d.ts",
      "default": "./dist/optional-typeorm.js"
    }
  },
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/!(*.spec|*.e2e-spec|*.fixture|*.mock).{js,d.ts}",
    "!dist/**/__tests__/**",
    "!dist/**/__fixtures__/**"
  ],
  "dependencies": {
    "@concepta/nestjs-core": "^8.0.0-alpha.9",
    "@concepta/nestjs-password": "8.0.0-alpha.9",
    "@concepta/nestjs-repository": "8.0.0-alpha.9",
    "@nestjs/common": "12.0.0-alpha.6",
    "@nestjs/config": "12.0.0-next.0",
    "@nestjs/core": "12.0.0-alpha.6",
    "@nestjs/cqrs": "^11.0.0",
    "@nestjs/swagger": "12.0.0-alpha.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@concepta/nestjs-crud": "8.0.0-alpha.9",
    "@concepta/nestjs-repository-typeorm": "8.0.0-alpha.9",
    "@concepta/typeorm-seeding": "^4.0.0",
    "@faker-js/faker": "^8.4.1",
    "@nestjs/testing": "12.0.0-alpha.6",
    "@nestjs/typeorm": "^11.0.3",
    "accesscontrol": "^2.2.1",
    "rxjs": "^7.8.1",
    "supertest": "^6.3.4",
    "vitest-mock-extended": "^4.0.0"
  },
  "peerDependencies": {
    "@concepta/nestjs-crud": "8.0.0-alpha.9",
    "typeorm": "^0.3.0"
  }
}
