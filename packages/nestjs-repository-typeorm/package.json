{
  "name": "@concepta/nestjs-repository-typeorm",
  "version": "8.0.0-alpha.7",
  "description": "Rockets NestJS TypeORM Repository Module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/cjs/**/!(*.spec|*.e2e-spec|*.fixture|*.mock).{js,d.ts}",
    "dist/esm/**/!(*.spec|*.e2e-spec|*.fixture|*.mock).{js,d.ts}",
    "dist/cjs/package.json",
    "dist/esm/package.json",
    "!dist/**/__tests__/**",
    "!dist/**/__fixtures__/**"
  ],
  "dependencies": {
    "@concepta/nestjs-core": "^8.0.0-alpha.7",
    "@concepta/nestjs-repository": "8.0.0-alpha.7",
    "@nestjs/common": "12.0.0-alpha.5",
    "@nestjs/typeorm": "^11.0.0",
    "@tsyche/membrane": "^0.7.0"
  },
  "devDependencies": {
    "@concepta/typeorm-seeding": "^4.0.0",
    "@faker-js/faker": "^8.4.1",
    "@nestjs/testing": "12.0.0-alpha.5",
    "sqlite3": "^5.1.4",
    "vitest-mock-extended": "^4.0.0"
  },
  "peerDependencies": {
    "class-transformer": "*",
    "class-validator": "*",
    "typeorm": "^0.3.0"
  },
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  }
}
