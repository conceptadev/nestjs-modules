{
  "name": "@concepta/nestjs-authentication",
  "version": "8.0.0-alpha.7",
  "description": "Rockets NestJS Authentication",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/cjs/**/!(*.spec|*.e2e-spec|*.fixture|*.mock).{js,d.ts}",
    "dist/esm/**/!(*.spec|*.e2e-spec|*.fixture|*.mock).{js,d.ts}",
    "dist/cjs/package.json",
    "dist/esm/package.json",
    "!dist/**/__tests__/**",
    "!dist/**/__fixtures__/**"
  ],
  "dependencies": {
    "@concepta/nestjs-core": "^8.0.0-alpha.7",
    "@concepta/nestjs-password": "8.0.0-alpha.7",
    "@concepta/nestjs-user": "8.0.0-alpha.7",
    "@nestjs/common": "12.0.0-alpha.5",
    "@nestjs/config": "12.0.0-next.0",
    "@nestjs/core": "12.0.0-alpha.5",
    "@nestjs/cqrs": "^11.0.0",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/swagger": "12.0.0-alpha.2",
    "jsonwebtoken": "^9.0.0",
    "ms": "^2.1.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "passport-strategy": "^1.0.0"
  },
  "devDependencies": {
    "@concepta/nestjs-crud": "8.0.0-alpha.7",
    "@concepta/nestjs-otp": "8.0.0-alpha.7",
    "@nestjs/testing": "12.0.0-alpha.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/passport-strategy": "^0.2.38",
    "express": "^4.21.0",
    "supertest": "^6.3.4",
    "vitest-mock-extended": "^4.0.0"
  },
  "peerDependencies": {
    "class-transformer": "*",
    "class-validator": "*",
    "rxjs": "^7.1.0"
  },
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  }
}
